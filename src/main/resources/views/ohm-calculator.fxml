<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.demo.controllers.OhmCalculatorController"
      spacing="15" style="-fx-padding: 20;">
    <Label text="Ohm's Law Calculator" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Voltage (V):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="voltageField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Current (I):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="currentField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Resistance (R):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="resistanceField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Calculate" onAction="#handleCalculate" style="-fx-font-size: 14;"/>

    <Label fx:id="resultLabel" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <Label text="History:" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <ListView fx:id="historyList" prefHeight="200"/>

    <Button text="Back to Menu" onAction="#handleBackToMenu"/>
</VBox>